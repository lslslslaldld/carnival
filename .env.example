# Amazon Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_yourPoolId
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_yourPoolId
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=yourUserPoolAppClientId
# Comma-separated emails allowed to administer this app
ADMIN_EMAILS=admin@example.com

# Neon Postgres (retained for app settings and page content)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
